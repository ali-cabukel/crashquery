Screen {
    background: #0d1117;
    color: #e6edf3;
}

Header {
    background: #005f87;
    color: #ffffff;
    text-style: bold;
}

Footer {
    background: #161b22;
}

#body {
    height: 1fr;
}

#chat-pane {
    width: 3fr;
    padding: 0 1;
}

#side {
    width: 2fr;
    min-width: 36;
    border-left: tall #21262d;
    padding: 0 1;
}

#chat {
    height: 1fr;
    background: #0d1117;
    color: #c9d1d9;
}

#schema-title, #sql-title, #tools-title {
    color: #58a6ff;
    text-style: bold;
    height: 1;
    margin-top: 1;
}

#schema {
    height: 8;
    background: #0d1117;
}

#sql {
    height: 1fr;
    min-height: 8;
    background: #0d1117;
    color: #c9d1d9;
}

#tools {
    height: auto;
    min-height: 4;
    color: #c9d1d9;
}

#status {
    color: #8b949e;
    padding: 0 1;
    height: 1;
}

#status.-error {
    color: #f85149;
}

#status.-busy {
    color: #d29922;
}

Input {
    border: tall #005f87;
    background: #161b22;
    margin: 0 1 1 1;
}

Input > .input--suggestion {
    color: #484f58;
}
